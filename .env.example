# Copie este arquivo para .env e ajuste os valores.

# Connection string do Postgres (Railway). Use um banco separado para
# desenvolvimento e outro para produção — nunca aponte o .env local pro
# banco de produção.
DATABASE_URL="postgresql://usuario:senha@host:porta/banco"

# Segredo usado para assinar o cookie de sessão (JWT). Gere um novo com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="troque-por-um-valor-aleatorio-e-secreto"

# Onde as fotos/anexos são armazenados: "local" (disco, padrão — usado em
# desenvolvimento) ou "blob" (Vercel Blob — usado em produção no Vercel,
# que não tem disco persistente).
STORAGE_DRIVER="local"

# Usado apenas quando STORAGE_DRIVER=local: diretório local para os anexos.
STORAGE_DIR="./storage/uploads"

# Usado apenas quando STORAGE_DRIVER=blob: token gerado automaticamente pelo
# Vercel ao conectar um Blob Store ao projeto (Storage → Blob Store →
# Connect Project). Não precisa preencher em desenvolvimento local.
# BLOB_READ_WRITE_TOKEN=""
